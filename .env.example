# Discord
DISCORD_TOKEN=

# Public API (proxy response.midnightlabs.tech to this service on port 3000)
PORT=3000
MAX_LENGTH=500
CALL_PREFIX_TEXT=Sent from Midnight Labs. SmartBoot:

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# FreePBX AMI (direct public IP and port; no VPN/tunnel)
PBX_HOST=
PBX_AMI_PORT=5038
PBX_AMI_USERNAME=smartboot
PBX_AMI_SECRET=
PBX_AMI_TLS=false

# SFTP audio delivery to FreePBX
PBX_SFTP_PORT=22
PBX_SFTP_USERNAME=
PBX_SFTP_PRIVATE_KEY=/run/secrets/pbx_ed25519
PBX_AUDIO_PATH=/var/lib/asterisk/sounds/smartboot
