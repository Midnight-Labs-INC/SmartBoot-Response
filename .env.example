# Discord
DISCORD_TOKEN=

# Public API
PORT=3000
MAX_LENGTH=500
CALL_PREFIX_TEXT=Sent from Midnight Labs. SmartBoot:

# Local Piper TTS
PIPER_BIN=/opt/piper/bin/piper
PIPER_MODEL=/opt/smartboot-response/models/en_US-lessac-medium.onnx

# FreePBX AMI
PBX_HOST=
PBX_AMI_PORT=5038
PBX_AMI_USERNAME=smartboot
PBX_AMI_SECRET=
PBX_AMI_TLS=false

# SFTP audio delivery
PBX_SFTP_HOST=
PBX_SFTP_PORT=22
PBX_SFTP_USERNAME=
PBX_SFTP_PRIVATE_KEY=/opt/smartboot-response/secrets/pbx_ed25519
PBX_AUDIO_PATH=/home/smartboot-sftp

# Discord administrators
ADMIN_DISCORD_IDS=
ADMIN_ROLE_IDS=
